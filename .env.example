# =============================================================================
# Configuration of a RUNNING CONTAINER, not of a build.
#
# The image is built once and the same artifact is promoted through every
# environment, so every value that differs between environments is read here,
# at startup or per request — never compiled into the bundle.
#
# The one exception is NEXT_PUBLIC_AUTH_ADAPTER at the bottom, which selects
# which auth adapter is compiled in. It is a build argument on purpose: see
# src/lib/auth/index.tsx and docs/deployment.md.
# =============================================================================

# --- PAP BFF (server-side only; never exposed to the browser) ---
# Base URL of the service-policy PDP.
PDP_BASE_URL=http://localhost:8080
# BFF service account (client_credentials) — the PAP's own identity toward the
# PDP. Its service account must carry the PDP's admin + delegation markers.
# Takes precedence over PDP_SERVICE_TOKEN when PDP_TOKEN_URL is set.
PDP_TOKEN_URL=            # https://<keycloak>/realms/<realm>/protocol/openid-connect/token
PDP_CLIENT_ID=
PDP_CLIENT_SECRET=
# Dev-only fallback: manually pasted token (expires in minutes). Never in
# shared environments.
PDP_SERVICE_TOKEN=

# --- Caller token verification (server-side; the BFF's door check) ---
# The BFF verifies every request's Bearer token against the issuer's published
# keys before it spends its own credential. Both values are REQUIRED: if either
# is missing or blank the BFF answers 500 and serves nothing — it never falls
# back to trusting the caller.
# Issuer of the tokens the PAP accepts. Must match the token's `iss` EXACTLY.
# The signing keys are found from here via OIDC discovery
# (<issuer>/.well-known/openid-configuration) — no separate JWKS URL to keep
# in sync.
PAP_OIDC_ISSUER=            # https://<idp-host>/realms/<realm>
# The OIDC client the PAP's own frontend logs in with: a token minted for any
# other client is rejected. Normally the same value as
# PAP_PUBLIC_KEYCLOAK_CLIENT_ID.
PAP_OIDC_CLIENT_ID=authz-admin
# Where the caller's roles and administrable apps live in the token. The values
# below are DEFAULTS matching Keycloak's token shape, not the contract — set
# them for any other IdP (Auth0, Okta, Entra put the same information
# elsewhere). Dot-paths into the verified payload. Leave blank to keep the
# default; a path that resolves to anything but an array of strings yields an
# empty list, which denies.
PAP_OIDC_ROLES_CLAIM_PATH=realm_access.roles
PAP_OIDC_APPS_CLAIM_PATH=authz_apps

# --- Public runtime configuration (reaches the browser) ---
# Read on the server per request and handed to the browser as props. They are
# public by nature — the browser is redirected to them — but nothing else may
# be added to this family: whatever is placed here is serialised into the HTML.
#
# Required when the image was built with the ricardoqmd-auth adapter; the
# adapter refuses to start without them, naming the one that is missing.
# Neutral placeholders — real values belong to each deployment, never to the repo.
PAP_PUBLIC_KEYCLOAK_URL=https://keycloak.example.com
PAP_PUBLIC_KEYCLOAK_REALM=example
PAP_PUBLIC_KEYCLOAK_CLIENT_ID=authz-admin

# UI locale when no NEXT_LOCALE cookie is set: "es" | "en". Resolved on the
# server, so it never reaches the bundle. Anything outside the list falls back
# to "es".
PAP_DEFAULT_LOCALE=es

# --- Build argument (NOT runtime) ---
# Which auth adapter is compiled in: "mock" (dev/tests; blocked in production)
# or "ricardoqmd-auth" (reference implementation, wired). Listed here because
# `next dev` reads it from this file; in a built image it is a --build-arg and
# changing it afterwards does nothing.
NEXT_PUBLIC_AUTH_ADAPTER=mock
